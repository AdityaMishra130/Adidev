@using CsharpProject.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0284c7" />
    <title>@ViewData["Title"] - Adidev Health Portal</title>
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="adidev-body">
    <!-- Top Navigation Header -->
    <header class="adidev-navbar sticky-top">
        <div class="container-fluid px-lg-4">
            <div class="d-flex align-items-center justify-content-between py-2">
                <!-- Brand / Logo -->
                <div class="d-flex align-items-center gap-3">
                    <a class="adidev-brand" asp-controller="Home" asp-action="Index">
                        <div class="brand-icon">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <div class="brand-text">
                            <span class="brand-title">adidev<span class="brand-accent">.health</span></span>
                            <span class="brand-subtitle">SIH HEALTHCARE PLATFORM</span>
                        </div>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(PortalRoles.Admin))
                        {
                            <span class="badge role-badge role-admin"><i class="bi bi-shield-lock-fill me-1"></i>ADMIN</span>
                        }
                        else if (User.IsInRole(PortalRoles.Doctor))
                        {
                            <span class="badge role-badge role-doctor"><i class="bi bi-stethoscope me-1"></i>DOCTOR</span>
                        }
                        else if (User.IsInRole(PortalRoles.Patient))
                        {
                            <span class="badge role-badge role-patient"><i class="bi bi-person-heart me-1"></i>PATIENT</span>
                        }
                    }
                </div>

                <!-- Navigation Links -->
                <nav class="d-none d-lg-flex align-items-center gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-item-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-1x2 me-1"></i> Dashboard
                        </a>
                        <a class="nav-item-link" asp-controller="Appointments" asp-action="Index">
                            <i class="bi bi-calendar2-check me-1"></i> Appointments
                        </a>
                        <a class="nav-item-link" asp-controller="Records" asp-action="Index">
                            <i class="bi bi-file-earmark-medical me-1"></i> Medical Records
                        </a>
                        <a class="nav-item-link" asp-controller="Doctors" asp-action="Index">
                            <i class="bi bi-people me-1"></i> Find Doctors
                        </a>

                        @if (User.IsInRole(PortalRoles.Admin))
                        {
                            <a class="nav-item-link" asp-controller="Departments" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Departments
                            </a>
                            <a class="nav-item-link" asp-controller="Doctors" asp-action="Manage">
                                <i class="bi bi-person-badge me-1"></i> Staff
                            </a>
                            <a class="nav-item-link" asp-controller="Account" asp-action="Patients">
                                <i class="bi bi-person-lines-fill me-1"></i> Patients
                            </a>
                        }
                        @if (User.IsInRole(PortalRoles.Doctor))
                        {
                            <a class="nav-item-link" asp-controller="Doctors" asp-action="Schedule">
                                <i class="bi bi-clock-history me-1"></i> Clinic Hours
                            </a>
                            <a class="nav-item-link" asp-controller="Account" asp-action="Patients">
                                <i class="bi bi-person-lines-fill me-1"></i> Patients
                            </a>
                        }
                        @if (User.IsInRole(PortalRoles.Patient))
                        {
                            <a class="nav-item-link" asp-controller="Documents" asp-action="Index">
                                <i class="bi bi-folder2 me-1"></i> Lab Reports
                            </a>
                        }
                    }
                    else
                    {
                        <a class="nav-item-link" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-item-link" asp-controller="Doctors" asp-action="Index">Our Specialists</a>
                        <a class="nav-item-link" asp-controller="Home" asp-action="Privacy">Security &amp; Compliance</a>
                    }
                </nav>

                <!-- Right Actions / Profile -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm btn-primary d-none d-md-inline-flex align-items-center gap-1 shadow-sm px-3" asp-controller="Appointments" asp-action="Create">
                            <i class="bi bi-plus-circle"></i> Book Visit
                        </a>

                        <!-- Notification Bell -->
                        <div class="position-relative me-2">
                            <a class="btn btn-icon-light position-relative" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                                <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                    0
                                </span>
                            </a>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn user-chip dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar-badge">@((User.Identity.Name ?? "U").Substring(0, 1).ToUpperInvariant())</span>
                                <span class="d-none d-sm-inline-block fw-semibold text-truncate" style="max-width: 140px;">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2 user-dropdown">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark">@User.Identity.Name</div>
                                    <small class="text-muted">Logged in account</small>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2 text-primary"></i> Medical Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-secondary"></i> Security &amp; Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button class="dropdown-item py-2 text-danger" type="submit">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm px-3" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                        <a class="btn btn-primary btn-sm px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="adidev-main py-4" role="main">
        <div class="container-fluid px-lg-4">
            @if (TempData["Notice"] is string notice)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@notice</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@error</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="adidev-footer py-4 mt-auto">
        <div class="container-fluid px-lg-4">
            <div class="row gy-3 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center gap-2 justify-content-center justify-content-md-start">
                        <i class="bi bi-heart-pulse-fill text-primary"></i>
                        <span class="fw-bold text-dark">Adidev Health Portal</span>
                        <span class="text-muted">| Smart India Hackathon (SIH) HealthTech Project</span>
                    </div>
                    <small class="text-muted d-block mt-1">HIPAA &amp; ABDM Compliant Architecture &bull; Secure Healthcare Management</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex gap-3 justify-content-center justify-content-md-end">
                        <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none small">Data Privacy</a>
                        <a asp-controller="Doctors" asp-action="Index" class="text-muted text-decoration-none small">Specialists Directory</a>
                        <span class="text-muted small"><i class="bi bi-telephone-inbound-fill text-danger me-1"></i>Emergency OPD: 108</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Live Notification Badge Polling -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function() {
                function updateUnreadBadge() {
                    $.getJSON('/Notifications/GetUnreadCount', function(data) {
                        var badge = $('#notificationBadge');
                        if (data && data.count > 0) {
                            badge.text(data.count).removeClass('d-none');
                        } else {
                            badge.addClass('d-none');
                        }
                    });
                }
                updateUnreadBadge();
                setInterval(updateUnreadBadge, 30000);
            })();
        </script>
    }
</body>
</html>
