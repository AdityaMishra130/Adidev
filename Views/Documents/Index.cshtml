@model List<CsharpProject.Models.MedicalDocument>
@{
    ViewData["Title"] = "Medical Documents & Lab Reports";
    string? patientId = ViewBag.TargetPatientId;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Medical Documents &amp; Diagnostic Reports</h3>
        <p class="text-muted small m-0">Secure repository for blood work, pathology, radiology scans, and clinical summaries</p>
    </div>
    <a asp-action="Upload" asp-route-patientId="@patientId" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-upload me-1"></i> Upload New Document
    </a>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="stat-icon stat-icon-accent mx-auto mb-3">
                <i class="bi bi-folder2-open"></i>
            </div>
            <h5 class="fw-bold text-dark">No medical documents uploaded yet</h5>
            <p class="text-muted small">Upload your lab test reports (PDF, JPG, PNG) to maintain a complete personal health record.</p>
            <a asp-action="Upload" asp-route-patientId="@patientId" class="btn btn-primary btn-sm px-4">Upload Document</a>
        </div>
    }
    @foreach (var doc in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="adidev-card p-4 h-100 d-flex flex-column shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon @(doc.DocumentType.Contains("Scan") ? "stat-icon-accent" : "stat-icon-danger")">
                        <i class="bi @(doc.ContentType.Contains("pdf") ? "bi-file-earmark-pdf-fill" : "bi-file-earmark-image-fill")"></i>
                    </div>
                    <div class="overflow-hidden">
                        <h6 class="fw-bold text-dark text-truncate m-0" title="@doc.Title">@doc.Title</h6>
                        <span class="badge bg-light text-secondary border mt-1">@doc.DocumentType</span>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 small mb-3 flex-grow-1">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Uploaded:</span>
                        <span class="fw-semibold">@doc.UploadedAtUtc.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">File Size:</span>
                        <span class="fw-semibold">@((doc.FileSizeBytes / 1024.0).ToString("0.0")) KB</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Patient:</span>
                        <span class="fw-semibold text-truncate" style="max-width: 140px;">@doc.Patient.DisplayName</span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                    <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary flex-fill" target="_blank">
                        <i class="bi bi-download me-1"></i> Download
                    </a>
                    <form asp-action="Delete" asp-route-id="@doc.Id" method="post" onsubmit="return confirm('Delete this medical document?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
