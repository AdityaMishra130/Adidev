@model CsharpProject.Models.AppointmentBookingViewModel
@{
    ViewData["Title"] = "Book Hospital Appointment";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-10">
        <div class="adidev-card p-4 p-md-5 shadow-sm">
            <div class="text-center mb-4">
                <div class="stat-icon stat-icon-primary mx-auto mb-3">
                    <i class="bi bi-calendar2-plus-fill"></i>
                </div>
                <h3 class="fw-bold text-dark m-0">Book Doctor Appointment</h3>
                <p class="text-muted small">Select department, specialist, and choose an available live 30-minute time slot</p>
            </div>

            <form asp-action="Create" method="post" id="bookingForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-4 mb-4">
                    <!-- Step 1: Department & Doctor -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-primary mb-3">
                                <span class="badge bg-primary rounded-circle me-1">1</span> Select Medical Specialty &amp; Doctor
                            </h6>

                            <div class="mb-3">
                                <label asp-for="DepartmentId" class="form-label fw-semibold small text-secondary">Department</label>
                                <select asp-for="DepartmentId" class="form-select" id="departmentSelect" asp-items="ViewBag.Departments">
                                    <option value="">All Departments</option>
                                </select>
                            </div>

                            @if (User.IsInRole(CsharpProject.Models.PortalRoles.Admin) || User.IsInRole(CsharpProject.Models.PortalRoles.Doctor))
                            {
                                <div class="mb-3">
                                    <label asp-for="PatientId" class="form-label fw-semibold small text-secondary">Patient</label>
                                    <select asp-for="PatientId" class="form-select" asp-items="ViewBag.Patients">
                                        <option value="">-- Current User (@User.Identity?.Name) --</option>
                                    </select>
                                    <small class="text-muted">Select patient, or leave blank to book for yourself.</small>
                                </div>
                            }

                            <div class="mb-3">
                                <label asp-for="DoctorId" class="form-label fw-semibold small text-secondary">Doctor / Specialist <span class="text-danger">*</span></label>
                                <select asp-for="DoctorId" class="form-select" id="doctorSelect" asp-items="ViewBag.Doctors">
                                    <option value="">-- Choose Specialist Doctor --</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger small"></span>
                            </div>

                            <div id="doctorSummaryBox" class="p-3 bg-white rounded-3 border small d-none">
                                <div class="fw-bold text-dark" id="docNameDisplay"></div>
                                <div class="text-muted" id="docSpecDisplay"></div>
                                <div class="text-success fw-bold mt-1" id="docFeeDisplay"></div>
                                <div class="text-secondary mt-1" id="docDaysDisplay"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Date & Available Slots -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-primary mb-3">
                                <span class="badge bg-primary rounded-circle me-1">2</span> Select Date &amp; Available Slot
                            </h6>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary">Appointment Date <span class="text-danger">*</span></label>
                                <input type="date" id="datePicker" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                            </div>

                            <!-- Hidden input bound to model StartsAt -->
                            <input type="hidden" asp-for="StartsAt" id="startsAtInput" />
                            <span asp-validation-for="StartsAt" class="text-danger small d-block mb-2"></span>

                            <label class="form-label fw-semibold small text-secondary d-block">Available Time Slots</label>
                            
                            <div id="slotsLoader" class="text-center py-3 text-muted small d-none">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div> Loading slots...
                            </div>

                            <div id="slotMessage" class="alert alert-info py-2 small d-none"></div>

                            <div id="slotsContainer" class="slot-grid mt-2" style="max-height: 220px; overflow-y: auto;">
                                <div class="text-muted small py-3 text-center w-100">Please choose a doctor to view consultation slots.</div>
                            </div>

                            <div id="selectedSlotIndicator" class="mt-3 p-2 bg-white rounded border text-success fw-bold small d-none">
                                <i class="bi bi-check-circle-fill me-1"></i> Selected: <span id="selectedSlotText"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Reason -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-primary mb-3">
                                <span class="badge bg-primary rounded-circle me-1">3</span> Reason for Consultation
                            </h6>
                            <label asp-for="Reason" class="form-label fw-semibold small text-secondary">Chief Complaint / Medical Symptoms <span class="text-danger">*</span></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Describe your symptoms, duration, or reason for this consultation..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm" id="submitBtn">
                        <i class="bi bi-calendar-check-fill me-1"></i> Confirm &amp; Book Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var selectedDoctorId = $('#doctorSelect').val();

            // Cascading Department -> Doctors
            $('#departmentSelect').change(function() {
                var deptId = $(this).val();
                if (!deptId) {
                    // Load all doctors
                    location.href = '/Appointments/Create';
                    return;
                }
                $.getJSON('/Doctors/GetByDepartment?departmentId=' + deptId, function(data) {
                    var doctorDropdown = $('#doctorSelect');
                    doctorDropdown.empty().append('<option value="">-- Choose Specialist Doctor --</option>');
                    $.each(data, function(i, doc) {
                        doctorDropdown.append($('<option>', {
                            value: doc.id,
                            text: doc.name + ' (' + doc.specialty + ') - ₹' + doc.consultationFee
                        }));
                    });
                    $('#slotsContainer').html('<div class="text-muted small py-3 text-center w-100">Please select a doctor to load available slots.</div>');
                });
            });

            // Doctor selected or date changed -> load slots
            $('#doctorSelect, #datePicker').change(function() {
                loadSlots();
            });

            function loadSlots() {
                var docId = $('#doctorSelect').val();
                var date = $('#datePicker').val();
                if (!docId || !date) return;

                $('#slotsLoader').removeClass('d-none');
                $('#slotMessage').addClass('d-none');
                $('#slotsContainer').empty();
                $('#selectedSlotIndicator').addClass('d-none');
                $('#startsAtInput').val('');

                $.getJSON('/Appointments/GetAvailableSlots?doctorId=' + docId + '&date=' + date, function(res) {
                    $('#slotsLoader').addClass('d-none');
                    if (!res.isWorkingDay) {
                        $('#slotMessage').text(res.message).removeClass('d-none');
                        return;
                    }

                    if (!res.slots || res.slots.length === 0) {
                        $('#slotMessage').text('No slots available for this date.').removeClass('d-none');
                        return;
                    }

                    $.each(res.slots, function(i, slot) {
                        var btn = $('<button type="button" class="slot-btn"></button>');
                        btn.text(slot.timeString);
                        btn.attr('data-iso', slot.dateTimeIso);

                        if (!slot.isAvailable) {
                            btn.prop('disabled', true);
                            btn.attr('title', slot.reason);
                        } else {
                            btn.click(function() {
                                $('.slot-btn').removeClass('selected');
                                $(this).addClass('selected');
                                $('#startsAtInput').val(slot.dateTimeIso);
                                $('#selectedSlotText').text(slot.timeString + ' on ' + date);
                                $('#selectedSlotIndicator').removeClass('d-none');
                            });
                        }
                        $('#slotsContainer').append(btn);
                    });
                }).fail(function() {
                    $('#slotsLoader').addClass('d-none');
                    $('#slotMessage').text('Failed to load slots. Please retry.').removeClass('d-none');
                });
            }

            if ($('#doctorSelect').val()) {
                loadSlots();
            }

            $('#bookingForm').submit(function(e) {
                if (!$('#startsAtInput').val()) {
                    $('#slotMessage').text('Please select one of the available time slots below before booking.').removeClass('d-none');
                    $('html, body').animate({
                        scrollTop: $("#slotsContainer").offset().top - 120
                    }, 200);
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
