@model CsharpProject.Models.Appointment
@{
    ViewData["Title"] = $"Appointment #{Model.Id}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Appointments
        </a>

        <div class="adidev-card p-4 p-md-5 shadow-sm mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pb-3 border-bottom mb-4">
                <div>
                    <span class="badge bg-light text-secondary border">APPOINTMENT #@Model.Id</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">Consultation Details</h3>
                </div>
                <div>
                    @switch (Model.Status)
                    {
                        case AppointmentStatus.Pending:
                            <span class="status-badge status-pending fs-6"><i class="bi bi-hourglass-split"></i> Pending Confirmation</span>
                            break;
                        case AppointmentStatus.Confirmed:
                            <span class="status-badge status-confirmed fs-6"><i class="bi bi-check2-circle"></i> Confirmed</span>
                            break;
                        case AppointmentStatus.Completed:
                            <span class="status-badge status-completed fs-6"><i class="bi bi-check-all"></i> Completed</span>
                            break;
                        case AppointmentStatus.Cancelled:
                            <span class="status-badge status-cancelled fs-6"><i class="bi bi-x-circle"></i> Cancelled</span>
                            break;
                        case AppointmentStatus.Rejected:
                            <span class="status-badge status-rejected fs-6"><i class="bi bi-slash-circle"></i> Rejected</span>
                            break;
                    }
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold text-primary mb-2"><i class="bi bi-person-heart me-1"></i> Patient Information</h6>
                        <div class="fw-bold text-dark">@Model.Patient.DisplayName</div>
                        <div class="small text-muted">Email: @Model.Patient.Email</div>
                        <div class="small text-muted">Phone: @(Model.Patient.PhoneNumber ?? "N/A")</div>
                        <div class="small text-muted">Blood Group: @(Model.Patient.BloodGroup ?? "N/A")</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold text-primary mb-2"><i class="bi bi-stethoscope me-1"></i> Doctor Information</h6>
                        <div class="fw-bold text-dark">Dr. @Model.Doctor.User.DisplayName</div>
                        <div class="small text-muted">@(Model.Doctor.Department?.Name ?? Model.Doctor.Specialty)</div>
                        <div class="small text-muted">Room: @Model.Doctor.RoomNumber</div>
                        <div class="small text-success fw-bold">Consultation Fee: ₹@Model.Doctor.ConsultationFee.ToString("0")</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-3 border rounded-3">
                        <h6 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-accent me-1"></i> Scheduled Appointment Timing</h6>
                        <div class="h5 fw-bold text-primary mb-0">@Model.StartsAt.ToString("dddd, dd MMMM yyyy &bull; hh:mm tt")</div>
                    </div>
                </div>

                <div class="col-12">
                    <h6 class="fw-bold text-dark mb-2">Reason for Consultation:</h6>
                    <p class="text-secondary p-3 bg-light rounded-3 border">@Model.Reason</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="col-12">
                        <div class="alert alert-danger mb-0">
                            <strong>Reason for Decline:</strong> @Model.RejectionReason
                        </div>
                    </div>
                }

                @if (Model.MedicalRecord != null)
                {
                    <div class="col-12">
                        <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                                <span class="fw-bold text-success">Consultation Completed &amp; Medical Record Attached</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Records" asp-action="Details" asp-route-id="@Model.MedicalRecord.Id" class="btn btn-sm btn-outline-success">
                                    View Diagnosis
                                </a>
                                <a asp-controller="Records" asp-action="Print" asp-route-id="@Model.MedicalRecord.Id" target="_blank" class="btn btn-sm btn-success">
                                    <i class="bi bi-printer me-1"></i> Print Rx
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Action Buttons Footer -->
            <div class="d-flex justify-content-between align-items-center pt-4 mt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>

                <div class="d-flex gap-2">
                    @if ((User.IsInRole(PortalRoles.Doctor) || User.IsInRole(PortalRoles.Admin)) && Model.Status == AppointmentStatus.Pending)
                    {
                        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Confirm Appointment
                            </button>
                        </form>
                    }

                    @if (User.IsInRole(PortalRoles.Doctor) && (Model.Status == AppointmentStatus.Confirmed || Model.Status == AppointmentStatus.Pending))
                    {
                        <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-primary fw-semibold">
                                <i class="bi bi-clipboard2-pulse me-1"></i> Mark Visited &amp; Prescribe
                            </button>
                        </form>
                    }

                    @if (Model.Status != AppointmentStatus.Completed && Model.Status != AppointmentStatus.Cancelled && Model.Status != AppointmentStatus.Rejected)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this appointment?');" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">Cancel Appointment</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
