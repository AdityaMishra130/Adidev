@model CsharpProject.Models.PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Portal Dashboard";
}

<!-- Welcome Banner -->
<div class="p-4 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #0891b2 100%);">
    <div class="row align-items-center gy-3">
        <div class="col-md-8">
            <h3 class="fw-bold text-white mb-1">Hello, @Model.Patient.DisplayName!</h3>
            <p class="text-white-50 m-0">Welcome to your personal digital health dashboard. Manage appointments, medical records, and digital prescriptions.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-light fw-bold text-primary shadow-sm px-4">
                <i class="bi bi-calendar-plus-fill me-1"></i> Book New Appointment
            </a>
        </div>
    </div>
</div>

<!-- Health Summary Vitals Card -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-widget stat-widget-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-number">@(Model.Patient.BloodGroup ?? "N/A")</div>
                    <div class="stat-label">Blood Group</div>
                </div>
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-droplet-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="stat-widget stat-widget-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-number">@Model.UpcomingAppointments.Count</div>
                    <div class="stat-label">Upcoming Visits</div>
                </div>
                <div class="stat-icon stat-icon-warning">
                    <i class="bi bi-calendar2-check-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="stat-widget stat-widget-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-number">@Model.RecentRecords.Count</div>
                    <div class="stat-label">Digital Prescriptions</div>
                </div>
                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-file-earmark-medical-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="stat-widget stat-widget-accent">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-number">@Model.Documents.Count</div>
                    <div class="stat-label">Lab Reports</div>
                </div>
                <div class="stat-icon stat-icon-accent">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Appointments & Allergies Bar -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="adidev-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-calendar2-week text-primary me-2"></i>Upcoming Consultations</h5>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View All</a>
            </div>

            @if (!Model.UpcomingAppointments.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                    You have no upcoming appointments scheduled.
                    <div class="mt-3">
                        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-sm px-4">
                            Book an Appointment Now
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var apt in Model.UpcomingAppointments)
                    {
                        <div class="p-3 bg-light rounded-3 border d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold text-dark">Dr. @apt.Doctor.User.DisplayName</span>
                                    <span class="badge bg-light text-primary border">@(apt.Doctor.Department?.Name ?? apt.Doctor.Specialty)</span>
                                    @switch (apt.Status)
                                    {
                                        case AppointmentStatus.Pending:
                                            <span class="status-badge status-pending">Awaiting Doctor Confirmation</span>
                                            break;
                                        case AppointmentStatus.Confirmed:
                                            <span class="status-badge status-confirmed">Confirmed (Room: @apt.Doctor.RoomNumber)</span>
                                            break;
                                    }
                                </div>
                                <div class="text-primary fw-semibold small">
                                    <i class="bi bi-clock me-1"></i> @apt.StartsAt.ToString("dddd, MMM dd, yyyy &bull; hh:mm tt")
                                </div>
                                <small class="text-muted">Reason: @apt.Reason</small>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a asp-controller="Appointments" asp-action="Details" asp-route-id="@apt.Id" class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                                <form asp-controller="Appointments" asp-action="Cancel" asp-route-id="@apt.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Health Profile Quick View -->
    <div class="col-lg-4">
        <div class="adidev-card p-4 shadow-sm h-100">
            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                <i class="bi bi-shield-plus text-danger me-2"></i> Medical Alerts &amp; Profile
            </h5>

            <div class="mb-3">
                <label class="fw-bold small text-muted d-block">Known Allergies:</label>
                @if (!string.IsNullOrEmpty(Model.Patient.Allergies))
                {
                    <span class="badge bg-warning bg-opacity-25 text-dark border border-warning fs-6">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>@Model.Patient.Allergies
                    </span>
                }
                else
                {
                    <span class="text-muted small">None recorded</span>
                }
            </div>

            <div class="mb-3">
                <label class="fw-bold small text-muted d-block">Chronic Illnesses:</label>
                <p class="small text-secondary m-0">@(Model.Patient.ExistingConditions ?? "None recorded")</p>
            </div>

            <div class="mb-3">
                <label class="fw-bold small text-muted d-block">Emergency Contact:</label>
                <div class="small fw-semibold text-dark">@(Model.Patient.EmergencyContactName ?? "Not provided")</div>
                <small class="text-muted">@(Model.Patient.EmergencyContactPhone ?? "")</small>
            </div>

            <div class="pt-3 border-top mt-auto">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-pencil-square me-1"></i> Update Health Profile
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Prescriptions & Reports Row -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="adidev-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-capsule text-success me-2"></i>My Prescriptions</h5>
                <a asp-controller="Records" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View All</a>
            </div>

            @if (!Model.RecentRecords.Any())
            {
                <div class="text-center py-4 text-muted small">
                    No prescriptions issued yet.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var rec in Model.RecentRecords)
                    {
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">Diagnosis: @rec.Diagnosis</span>
                                <a asp-controller="Records" asp-action="Print" asp-route-id="@rec.Id" target="_blank" class="btn btn-sm btn-outline-secondary py-0">
                                    <i class="bi bi-printer me-1"></i> Print Rx
                                </a>
                            </div>
                            <small class="text-muted d-block mb-2">Prescribed on @rec.CreatedAtUtc.ToString("dd MMM yyyy")</small>
                            @if (rec.Prescriptions.Any())
                            {
                                <div class="small text-secondary">
                                    <strong>Medicines:</strong>
                                    @string.Join(", ", rec.Prescriptions.Select(p => $"{p.Medication} ({p.Dosage})"))
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="adidev-card shadow-sm p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-folder2 text-primary me-2"></i>Lab Reports &amp; Scans</h5>
                <a asp-controller="Documents" asp-action="Upload" class="btn btn-sm btn-primary py-0">
                    <i class="bi bi-upload me-1"></i> Upload
                </a>
            </div>

            @if (!Model.Documents.Any())
            {
                <div class="text-center py-4 text-muted small">
                    No documents uploaded. Click 'Upload' to attach blood tests, X-rays, or MRI scans.
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="p-2 border rounded-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                                <div>
                                    <div class="fw-semibold small text-truncate" style="max-width: 170px;">@doc.Title</div>
                                    <small class="text-muted">@doc.UploadedAtUtc.ToString("dd MMM yyyy")</small>
                                </div>
                            </div>
                            <a asp-controller="Documents" asp-action="Download" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary py-0 px-2" target="_blank">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
