@model PasswordChangeViewModel
@{
    ViewData["Title"] = "Security & Change Password";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="adidev-card p-4 p-md-5 shadow-sm">
            <div class="text-center mb-4">
                <div class="stat-icon stat-icon-primary mx-auto mb-3">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h4 class="fw-bold text-dark m-0">Change Password</h4>
                <p class="text-muted small">Update your account login credentials</p>
            </div>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                    <button class="btn btn-primary fw-bold px-4" type="submit">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
