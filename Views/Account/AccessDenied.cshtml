@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="adidev-card p-5 shadow-sm">
            <div class="stat-icon stat-icon-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
            <p class="text-muted small mb-4">
                You do not have the required role permissions to view or perform operations on this healthcare resource.
            </p>
            <a class="btn btn-primary px-4 fw-semibold" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-house-door me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
