@model List<CsharpProject.Models.AppUser>
@{
    ViewData["Title"] = "Patients Directory";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Registered Patients Directory</h3>
        <p class="text-muted small m-0">Comprehensive patient records, medical profiles, and contact details</p>
    </div>
    <span class="badge bg-primary px-3 py-2 fs-6">Total: @Model.Count Patients</span>
</div>

<!-- Search Bar -->
<div class="adidev-card p-3 mb-4 shadow-sm">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search patients by name, email, phone number, or blood group..." value="@ViewBag.SearchTerm" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold">Search</button>
        </div>
    </form>
</div>

<div class="adidev-card shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="adidev-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Contact</th>
                    <th>Age / Gender</th>
                    <th>Blood Group</th>
                    <th>Emergency Contact</th>
                    <th>Allergies &amp; History</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                            No patients found matching your search.
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-badge">@p.DisplayName.Substring(0, 1).ToUpperInvariant()</span>
                                <div>
                                    <div class="fw-bold text-dark">@p.DisplayName</div>
                                    <small class="text-muted">Registered: @p.CreatedAtUtc.ToString("MMM yyyy")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div><i class="bi bi-envelope text-muted me-1"></i>@p.Email</div>
                            <small class="text-muted"><i class="bi bi-telephone text-muted me-1"></i>@(p.PhoneNumber ?? "N/A")</small>
                        </td>
                        <td>
                            @if (p.DateOfBirth.HasValue)
                            {
                                var age = DateTime.Today.Year - p.DateOfBirth.Value.Year;
                                <div>@age yrs (@p.DateOfBirth.Value.ToString("dd MMM yyyy"))</div>
                            }
                            else
                            {
                                <div>N/A</div>
                            }
                            <span class="badge bg-light text-secondary border">@(p.Gender ?? "Not specified")</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.BloodGroup))
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                    <i class="bi bi-droplet-fill me-1"></i>@p.BloodGroup
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Unknown</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.EmergencyContactName))
                            {
                                <div class="fw-semibold small">@p.EmergencyContactName</div>
                                <small class="text-muted">@p.EmergencyContactPhone</small>
                            }
                            else
                            {
                                <span class="text-muted small">None listed</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.Allergies))
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning mb-1 d-inline-block">
                                    Allergy: @p.Allergies
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(p.ExistingConditions))
                            {
                                <small class="text-secondary d-block">@p.ExistingConditions</small>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="PatientDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-file-earmark-medical me-1"></i> Full Record
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
