@model CsharpProject.Models.UserProfileViewModel
@{
    ViewData["Title"] = "My Medical Profile";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9">
        <div class="adidev-card p-4 p-md-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark m-0">Personal &amp; Medical Profile</h3>
                    <p class="text-muted small m-0">Manage your contact, emergency details, and clinical history summary</p>
                </div>
                <div class="avatar-badge" style="width: 52px; height: 52px; font-size: 1.25rem;">
                    @Model.DisplayName.Substring(0, 1).ToUpperInvariant()
                </div>
            </div>

            <form asp-action="Profile" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DisplayName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BloodGroup" class="form-label fw-semibold small text-secondary"></label>
                        <select asp-for="BloodGroup" class="form-select">
                            <option value="">Select Blood Group</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                        </select>
                        <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-12 pt-3">
                        <h6 class="fw-bold text-danger"><i class="bi bi-shield-exclamation me-1"></i> Emergency Contact Information</h6>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmergencyContactName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                        <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmergencyContactPhone" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="EmergencyContactPhone" class="form-control" />
                        <span asp-validation-for="EmergencyContactPhone" class="text-danger small"></span>
                    </div>

                    <div class="col-12 pt-3">
                        <h6 class="fw-bold text-primary"><i class="bi bi-heart-pulse me-1"></i> Clinical History &amp; Allergies</h6>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Allergies" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Allergies" class="form-control" rows="2" placeholder="e.g. Penicillin, Peanuts, Pollen"></textarea>
                        <span asp-validation-for="Allergies" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExistingConditions" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="ExistingConditions" class="form-control" rows="2" placeholder="e.g. Hypertension, Type 2 Diabetes, Asthma"></textarea>
                        <span asp-validation-for="ExistingConditions" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
