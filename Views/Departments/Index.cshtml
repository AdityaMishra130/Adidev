@model List<CsharpProject.Models.Department>
@{
    ViewData["Title"] = "Department Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Hospital Departments &amp; Specialities</h3>
        <p class="text-muted small m-0">Organize clinical specialties, centers of excellence, and doctor allocations</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Add New Department
    </a>
</div>

<div class="row g-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="adidev-card p-4 h-100 shadow-sm d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon stat-icon-primary">
                            <i class="bi @dept.Icon"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold m-0 text-dark">@dept.Name</h5>
                            <small class="text-muted">@dept.Doctors.Count Active Doctors</small>
                        </div>
                    </div>
                    <span class="badge @(dept.IsActive ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-secondary bg-opacity-10 text-secondary border")">
                        @(dept.IsActive ? "Active" : "Inactive")
                    </span>
                </div>

                <p class="text-secondary small mb-4 flex-grow-1">@dept.Description</p>

                <div class="border-top pt-3 d-flex align-items-center justify-content-between">
                    <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <form asp-action="ToggleStatus" asp-route-id="@dept.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(dept.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(dept.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
