@model CsharpProject.Models.MedicalRecord
@{
    Layout = null; // Clean standalone printable prescription
    var patient = Model.Patient ?? Model.Appointment.Patient;
    var doctor = Model.Doctor ?? Model.Appointment.Doctor;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prescription_#@Model.Id - Adidev Healthcare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { background: #f1f5f9; padding: 20px 0; }
        .prescription-container {
            background: white;
            max-width: 820px;
            margin: auto;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }
        .header-logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0284c7;
        }
        .rx-badge {
            font-family: serif;
            font-size: 2.4rem;
            font-weight: bold;
            color: #0284c7;
            line-height: 1;
        }
        .section-title {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #0369a1;
            border-bottom: 2px solid #e0f2fe;
            padding-bottom: 4px;
            margin-bottom: 12px;
        }
        @@media print {
            body { background: white !important; padding: 0 !important; }
            .prescription-container { border: none !important; box-shadow: none !important; padding: 20px 0 !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-primary px-4 shadow-sm fw-bold me-2">
            <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary">Close</button>
    </div>

    <div class="prescription-container">
        <!-- Hospital Header -->
        <div class="row align-items-center pb-3 border-bottom border-2 border-primary">
            <div class="col-8">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-heart-pulse-fill fs-2 text-primary"></i>
                    <span class="header-logo">adidev<span class="text-dark">.health</span></span>
                </div>
                <div class="fw-bold text-dark">ADIDEV MULTISPECIALTY HOSPITAL &amp; RESEARCH CENTER</div>
                <div class="small text-muted">108 Healthcare Boulevard, Technology Park, New Delhi - 110001</div>
                <div class="small text-muted">Helpline: +91 11 2345 6789 &bull; Emergency OPD: 108 &bull; info@adidevhealth.com</div>
            </div>
            <div class="col-4 text-end">
                <div class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 mb-1">
                    Rx #@Model.Id
                </div>
                <div class="small text-muted">Date: <strong>@Model.CreatedAtUtc.ToString("dd MMM yyyy")</strong></div>
                <div class="small text-muted">Time: <strong>@Model.CreatedAtUtc.ToString("hh:mm tt")</strong></div>
            </div>
        </div>

        <!-- Doctor Details Banner -->
        <div class="row py-3 border-bottom">
            <div class="col-7">
                <h5 class="fw-bold text-dark mb-0">Dr. @(doctor?.User?.DisplayName ?? "Medical Specialist")</h5>
                <div class="text-primary small fw-semibold">@(doctor?.Qualification ?? "MBBS, MD") &bull; @(doctor?.Department?.Name ?? doctor?.Specialty)</div>
                <div class="text-muted small">OPD Clinic: Room @(doctor?.RoomNumber ?? "101") &bull; Reg. No: MCI-@(doctor?.Id * 1423 + 70000)</div>
            </div>
            <div class="col-5 text-end small">
                <div class="text-muted">Appointment Ref: <strong>#@Model.AppointmentId</strong></div>
                <div class="text-muted">Status: <strong>Completed Visit</strong></div>
            </div>
        </div>

        <!-- Patient Demographics Bar -->
        <div class="row py-3 bg-light rounded-3 my-3 small">
            <div class="col-4">
                <span class="text-muted">Patient Name:</span>
                <div class="fw-bold text-dark">@patient.DisplayName</div>
            </div>
            <div class="col-2">
                <span class="text-muted">Gender:</span>
                <div class="fw-bold text-dark">@(patient.Gender ?? "N/A")</div>
            </div>
            <div class="col-2">
                <span class="text-muted">Age:</span>
                <div class="fw-bold text-dark">@(patient.DateOfBirth.HasValue ? (DateTime.Today.Year - patient.DateOfBirth.Value.Year) + " yrs" : "N/A")</div>
            </div>
            <div class="col-2">
                <span class="text-muted">Blood Group:</span>
                <div class="fw-bold text-danger">@(patient.BloodGroup ?? "N/A")</div>
            </div>
            <div class="col-2 text-end">
                <span class="text-muted">Patient ID:</span>
                <div class="fw-bold text-dark">#@patient.Id.Substring(0, Math.Min(6, patient.Id.Length))</div>
            </div>
        </div>

        <!-- Vitals Strip -->
        @if (!string.IsNullOrEmpty(Model.BloodPressure) || !string.IsNullOrEmpty(Model.HeartRate) || !string.IsNullOrEmpty(Model.Temperature))
        {
            <div class="row g-2 text-center my-3 small">
                @if (!string.IsNullOrEmpty(Model.BloodPressure))
                {
                    <div class="col">
                        <div class="p-1 border rounded bg-white"><strong>BP:</strong> @Model.BloodPressure</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.HeartRate))
                {
                    <div class="col">
                        <div class="p-1 border rounded bg-white"><strong>Pulse:</strong> @Model.HeartRate</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Temperature))
                {
                    <div class="col">
                        <div class="p-1 border rounded bg-white"><strong>Temp:</strong> @Model.Temperature</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.SpO2))
                {
                    <div class="col">
                        <div class="p-1 border rounded bg-white"><strong>SpO2:</strong> @Model.SpO2</div>
                    </div>
                }
                @if (Model.WeightKg.HasValue)
                {
                    <div class="col">
                        <div class="p-1 border rounded bg-white"><strong>Weight:</strong> @Model.WeightKg.Value.ToString("0.0") kg</div>
                    </div>
                }
            </div>
        }

        <!-- Clinical Diagnosis -->
        <div class="mb-4">
            <div class="section-title">Clinical Assessment &amp; Diagnosis</div>
            <div class="h6 fw-bold text-dark">@Model.Diagnosis</div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="text-secondary small mt-1">@Model.Notes</div>
            }
        </div>

        <!-- Prescription Rx Table -->
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="rx-badge">℞</span>
                <span class="section-title mb-0 flex-grow-1">Medical Prescriptions</span>
            </div>

            <table class="table table-sm table-bordered">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 35%;">Medication</th>
                        <th style="width: 15%;">Dosage</th>
                        <th style="width: 15%;">Frequency</th>
                        <th style="width: 15%;">Duration</th>
                        <th style="width: 15%;">Food Timing</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @{ int i = 1; }
                    @foreach (var p in Model.Prescriptions)
                    {
                        <tr>
                            <td>@(i++)</td>
                            <td>
                                <strong class="text-dark">@p.Medication</strong>
                                @if (!string.IsNullOrEmpty(p.Instructions))
                                {
                                    <div class="text-muted" style="font-size: 0.75rem;">@p.Instructions</div>
                                }
                            </td>
                            <td>@p.Dosage</td>
                            <td>@p.Frequency</td>
                            <td>@p.Duration</td>
                            <td>@p.MealTiming</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Advice & Follow-up -->
        <div class="row pt-3 border-top">
            <div class="col-8">
                <div class="small">
                    @if (Model.FollowUpDate.HasValue)
                    {
                        <div class="fw-bold text-primary mb-1">
                            <i class="bi bi-calendar-event me-1"></i> Next Follow-up: @Model.FollowUpDate.Value.ToString("dd MMMM yyyy")
                        </div>
                    }
                    <div class="text-muted mt-2">
                        &bull; Complete the full antibiotic course as prescribed.<br />
                        &bull; In case of unexpected allergic reaction or high fever, contact emergency immediately.
                    </div>
                </div>
            </div>
            <div class="col-4 text-end mt-4">
                <div class="fw-bold text-dark border-bottom pb-1 d-inline-block" style="min-width: 160px;">
                    Dr. @(doctor?.User?.DisplayName ?? "Specialist")
                </div>
                <div class="small text-muted mt-1">Authorized Digital Signature</div>
            </div>
        </div>

        <!-- Footer Seal -->
        <div class="mt-4 pt-3 border-top text-center text-muted small" style="font-size: 0.72rem;">
            Generated electronically by Adidev Health Hospital Management Portal &bull; Smart India Hackathon (SIH) HealthTech Project &bull; Verified Digital Health Record
        </div>
    </div>
</body>
</html>
