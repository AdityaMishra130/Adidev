@model CsharpProject.Models.Doctor
@{
    ViewData["Title"] = $"Dr. {Model.User.DisplayName}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Specialist Directory
        </a>

        <div class="adidev-card p-4 p-md-5 shadow-sm mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 pb-4 border-bottom">
                <div class="d-flex align-items-center gap-4">
                    <span class="avatar-badge" style="width: 76px; height: 76px; font-size: 2rem;">
                        @Model.User.DisplayName.Substring(Model.User.DisplayName.IndexOf(" ") + 1 > 0 ? Model.User.DisplayName.IndexOf(" ") + 1 : 0, 1)
                    </span>
                    <div>
                        <h2 class="fw-bold text-dark m-0">@Model.User.DisplayName</h2>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fs-6 mt-1">
                            @(Model.Department?.Name ?? Model.Specialty)
                        </span>
                        <div class="text-muted mt-1">@Model.Qualification &bull; @Model.ExperienceYears Years Clinical Experience</div>
                    </div>
                </div>
                <div class="text-md-end">
                    <div class="h4 fw-bold text-success mb-2">₹@Model.ConsultationFee.ToString("0") <small class="text-muted fs-6">/ consultation</small></div>
                    <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="bi bi-calendar-plus-fill me-1"></i> Book Appointment
                    </a>
                </div>
            </div>

            <div class="row g-4 mt-3">
                <div class="col-md-7">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-vcard text-primary me-2"></i>About the Specialist</h5>
                    <p class="text-secondary leading-relaxed">
                        @(Model.Bio ?? $"{Model.User.DisplayName} is a highly accomplished specialist practicing in {Model.Department?.Name ?? Model.Specialty}. Dedicated to evidence-based healthcare and patient-centric treatment.")
                    </p>

                    <h6 class="fw-bold text-dark mt-4 mb-2"><i class="bi bi-award text-accent me-2"></i>Medical Qualifications</h6>
                    <p class="text-secondary small">@Model.Qualification</p>
                </div>

                <div class="col-md-5">
                    <div class="p-4 bg-light rounded-3 border">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Clinic OPD Schedule</h6>
                        <div class="d-flex flex-column gap-2 small">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">OPD Room:</span>
                                <span class="fw-bold text-dark">@Model.RoomNumber</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Working Days:</span>
                                <span class="fw-bold text-dark">@Model.AvailableDays</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Consultation Hours:</span>
                                <span class="fw-bold text-dark">@Model.StartTime.ToString("hh\\:mm tt") - @Model.EndTime.ToString("hh\\:mm tt")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Slot Interval:</span>
                                <span class="fw-bold text-dark">30 Minutes</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
