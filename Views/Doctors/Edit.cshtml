@model CsharpProject.Models.EditDoctorViewModel
@{
    ViewData["Title"] = "Edit Doctor Details";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="adidev-card p-4 p-md-5 shadow-sm">
            <div class="text-center mb-4">
                <div class="stat-icon stat-icon-primary mx-auto mb-3">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h3 class="fw-bold text-dark m-0">Edit Doctor Profile</h3>
                <p class="text-muted small">Update practitioner credentials and clinical timings</p>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DisplayName" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label fw-semibold small text-secondary">Department</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                            <option value="">Select Department</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Specialty" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Specialty" class="form-control" />
                        <span asp-validation-for="Specialty" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Qualification" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="Qualification" class="form-control" />
                        <span asp-validation-for="Qualification" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ExperienceYears" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="ExperienceYears" class="form-control" type="number" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ConsultationFee" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="ConsultationFee" class="form-control" type="number" step="50" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RoomNumber" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="RoomNumber" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label fw-semibold small text-secondary"></label>
                        <textarea asp-for="Bio" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-12 pt-3">
                        <h6 class="fw-bold text-primary"><i class="bi bi-clock me-1"></i> Clinic Operating Schedule</h6>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AvailableDays" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="AvailableDays" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="StartTime" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="StartTime" class="form-control" type="time" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="EndTime" class="form-label fw-semibold small text-secondary"></label>
                        <input asp-for="EndTime" class="form-control" type="time" />
                    </div>

                    <div class="col-12 form-check mt-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary">Active Practitioner</label>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-4 mt-3 border-top">
                    <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Save Doctor Details</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
