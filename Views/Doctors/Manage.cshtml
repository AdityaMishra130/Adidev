@model List<CsharpProject.Models.Doctor>
@{
    ViewData["Title"] = "Manage Clinicians";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Clinician &amp; Doctor Roster</h3>
        <p class="text-muted small m-0">Administer hospital practitioners, specialties, fees, and operational status</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Add New Doctor
    </a>
</div>

<div class="adidev-card shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="adidev-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Doctor Name</th>
                    <th>Department &amp; Specialty</th>
                    <th>Qualifications &amp; Exp</th>
                    <th>Fee (INR)</th>
                    <th>Clinic OPD</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-badge">@doc.User.DisplayName.Substring(doc.User.DisplayName.IndexOf(" ") + 1 > 0 ? doc.User.DisplayName.IndexOf(" ") + 1 : 0, 1)</span>
                                <div>
                                    <div class="fw-bold text-dark">@doc.User.DisplayName</div>
                                    <small class="text-muted">@doc.User.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-primary border">@(doc.Department?.Name ?? "General")</span>
                            <div class="small text-muted mt-1">@doc.Specialty</div>
                        </td>
                        <td>
                            <div class="small fw-semibold">@doc.Qualification</div>
                            <small class="text-muted">@doc.ExperienceYears Yrs Experience</small>
                        </td>
                        <td class="fw-bold text-success">
                            ₹@doc.ConsultationFee.ToString("0")
                        </td>
                        <td>
                            <div class="small">Room: @doc.RoomNumber</div>
                            <small class="text-muted">@doc.StartTime.ToString("hh\\:mm") - @doc.EndTime.ToString("hh\\:mm")</small>
                        </td>
                        <td>
                            <span class="badge @(doc.IsActive ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-danger bg-opacity-10 text-danger border")">
                                @(doc.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@doc.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(doc.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(doc.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
